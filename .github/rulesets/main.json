{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "node 20 / ubuntu-latest" },
          { "context": "node 22 / ubuntu-latest" },
          { "context": "node 20 / macos-latest" },
          { "context": "node 22 / macos-latest" },
          { "context": "bridge (python 3.10)" },
          { "context": "bridge (python 3.12)" },
          { "context": "menu bar app builds and reads the daemon" },
          { "context": "analyze (actions)" },
          { "context": "analyze (javascript-typescript)" },
          { "context": "analyze (python)" }
        ]
      }
    }
  ]
}
