{
  "name": "clawdbox",
  "version": "0.4.3",
  "description": "Claude Code companion for the Divoom TimeBox Evo: hooks drive a pixel-art Clawd on a 16x16 LED matrix",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "clawdbox": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts daemon --mock",
    "daemon": "tsx src/cli.ts daemon",
    "test": "tsx --test test/*.test.ts",
    "anims": "tsx src/cli.ts build-anims",
    "sprites": "tsx src/cli.ts sprites",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" web/index.html",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" web/index.html",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "optionalDependencies": {
    "bluetooth-serial-port": "^3.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "prettier": "^3.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edmerrett/clawdbox.git"
  },
  "homepage": "https://github.com/edmerrett/clawdbox#readme",
  "bugs": {
    "url": "https://github.com/edmerrett/clawdbox/issues"
  },
  "author": "Ed Merrett <edward.merrett@gmail.com>",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "divoom",
    "timebox-evo",
    "pixel-art",
    "led-matrix",
    "bluetooth",
    "desk-toy"
  ],
  "files": [
    "assets/Clawd.icns",
    "dist",
    "art/anims",
    "art/README.md",
    "bridge/clawdbox_ble.py",
    "bridge/requirements.txt",
    "scripts/update.sh",
    "web",
    "hooks",
    "menubar/ClawdboxApp.swift",
    "menubar/Info.plist",
    "menubar/build.sh",
    "menubar/install.sh",
    "menubar/uninstall.sh",
    "README.md",
    "LICENSE"
  ]
}
